{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vault PW Manager",
  "version": "2.1.0",
  "identifier": "com.ozay.vault-pw-manager",
  "build": {
    "frontendDist": "../dist/desktop",
    "beforeDevCommand": "node esbuild.config.mjs desktop",
    "beforeBuildCommand": "node esbuild.config.mjs desktop"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local, encrypted password manager",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Turkish"]
      }
    }
  }
}
